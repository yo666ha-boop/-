tats.rating)/400)),old=stats.rating;stats.rating=Math.max(600,Math.min(3400,Math.round(stats.rating+24*(r-exp))));saveStats();renderStats();return stats.rating-old}
function renderStats(){let cs=stats.chars[ci]||{w:0,l:0,d:0};document.getElementById('statsMain').textContent='あなた R'+stats.rating;document.getElementById('statsSub').textContent=stats.w+'勝 '+stats.l+'敗 '+stats.d+'分　vs '+C[ci][0]+' '+cs.w+'-'+cs.l+'-'+cs.d}
function setResult(kind,text){let e=document.getElementById('resultBanner');e.className='resultBanner on result-'+kind;e.textContent=text}
function clearResult(){let e=document.getElementById('resultBanner');e.className='resultBanner';e.textContent=''}
function finishIfEnded(){let rep=repetitionResult();if(rep){let delta=0;if(rep.type=='perpetual'){delta=rep.winner===S?recordResult(1):recordResult(0);if(rep.winner===S){setStatus('勝ちです。相手の連続王手による千日手で反則勝ちです。');setResult('win','連続王手の千日手・勝ち　R '+(delta>=0?'+':'')+delta);speechMood='loss'}else{setStatus('負けです。連続王手による千日手で反則負けです。');setResult('loss','連続王手の千日手・負け　R '+(delta>=0?'+':'')+delta);speechMood='win'}}else{gameCounted=true;setStatus('千日手です。同一局面4回。公式ルールでは先後を交代して指し直しです。');setResult('draw','千日手・指し直し対象（R変動なし）');speechMood='normal'}lastSpeech='';render();renderOpponent(true);let rb=document.getElementById('reviewBtn');if(rb)rb.textContent='対局を振り返る';let rs=document.getElementById('reviewStatus');if(rs)rs.textContent='対局が終わりました。AI先生と一局を振り返れます。';return true}let lm=legal(st);if(lm.length)return false;let checked=incheck(st,st.t),winner=checked?-st.t:0,delta=0;if(winner===S)delta=recordResult(1);else if(winner===G)delta=recordResult(0);else delta=recordResult(.5);if(winner===S){setStatus('勝ちです。相手玉を詰ませました。');setResult('win','勝ち　R '+(delta>=0?'+':'')+delta);speechMood='loss'}else if(winner===G){setStatus('負けです。あなたの玉が詰みました。');setResult('loss','負け　R '+(delta>=0?'+':'')+delta);speechMood='win'}else{setStatus('引き分けです。');setResult('draw','引き分け　R '+(delta>=0?'+':'')+delta);speechMood='normal'}lastSpeech='';render();renderOpponent(true);let rb=document.getElementById('reviewBtn');if(rb)rb.textContent='対局を振り返る';let rs=document.getElementById('reviewStatus');if(rs)rs.textContent='対局が終わりました。AI先生と一局を振り返れます。';return true}
function jpMove(m,s){if(!m)return'—';let[x,y]=xy(m.to),sq=String(9-x)+'一二三四五六七八九'[y],k=m.drop?m.drop:(s.b[m.f]?s.b[m.f].k:'P');return'▲'+sq+KJ[m.prom?PRO(k):k]+(m.drop?'打':m.prom?'成':'')}
function materialDiff(s){let v=0;for(let p of s.b)if(p&&p.k!='K')v+=(p.o==S?1:-1)*VAL[p.k];for(const side of[S,G])for(const k in s.h[side])v+=(side==S?1:-1)*(s.h[side][k]||0)*VAL[k]*.94;return Math.round(v)}
function shape(score){if(score>500)return'先手有利';if(score>160)return'やや先手';if(score<-500)return'後手有利';if(score<-160)return'やや後手';return'互角'}
function grade(diff){if(diff<55)return['好手','grade-good'];if(diff<140)return['まずまず','grade-ok'];if(diff<300)return['疑問手','grade-q'];return['悪手','grade-bad']}
function reviewGrade(diff){if(diff<55)return['好手','review-good'];if(diff<140)return['まずまず','review-ok'];if(diff<300)return['疑問手','review-q'];return['悪手','review-bad']}
function resetReview(){reviewTrail=[];reviewResults=[];reviewRunning=false;let b=document.getElementById('reviewBtn'),stt=document.getElementById('reviewStatus'),sum=document.getElementById('reviewSummary'),pf=document.getElementById('reviewProgressFill');if(b){b.disabled=false;b.textContent='ここまで振り返る'}if(stt)stt.textContent='あなたが1手以上指すと振り返れます。終局後は「対局を振り返る」に変わります。';if(sum)sum.innerHTML='';if(pf)pf.style.width='0%'}
function syncReviewAfterUndo(){reviewTrail=reviewTrail.filter(x=>x.ply<=st.log.length);reviewResults=[];let sum=document.getElementById('reviewSummary'),pf=document.getElementById('reviewProgressFill'),stt=document.getElementById('reviewStatus');if(sum)sum.innerHTML='';if(pf)pf.style.width='0%';if(stt)stt.textContent=reviewTrail.length?'待った後の棋譜に合わせました。もう一度振り返れます。':'あなたが1手以上指すと振り返れます。'}
function reviewLessonFrom(r){if(!r)return'一手ずつ丁寧に考える習慣を続けましょう。';let s=r.before,m=r.best;if(incheck(s,S))return'王手を受けている局面では、まず王の安全を確保する候補を全部確認しましょう。';if(m){let cap=s.b[m.to],n=apply(s,m);if(cap&&VAL[cap.k]>=500)return'取れる大きな駒を見逃さないこと。攻める前に「相手の駒を取れる手」を毎回確認しましょう。';if(incheck(n,n.t))return'終盤では王手の連続性が重要です。王手をかけた後の相手玉の逃げ道まで読む練習をしましょう。';if(m.prom)return'敵陣に入った駒は「成ることで働きがどれだけ増えるか」を先に確認しましょう。'}if(materialDiff(s)<-450)return'駒損している時は、無理な攻めより「駒を取り返せる当たり」や両取りを探す習慣をつけましょう。';if(r.diff>=300)return'大きく形勢を落とす一手を減らすのが最優先です。指す前に「相手の次の一手」を1回だけ必ず確認しましょう。';return'大きな崩れは少なめです。王の安全と駒の働きを両立させる手を続けて選びましょう。'}
function reviewGraphHTML(rs,worst){if(!rs||!rs.length)return'';let W=280,H=126,L=31,R=9,T=12,B=24,iw=W-L-R,ih=H-T-B,n=rs.length,cap=1200;let clamp=v=>Math.max(-cap,Math.min(cap,Number.isFinite(v)?v:0)),x=i=>L+(n<=1?iw/2:iw*i/(n-1)),y=v=>T+ih/2-clamp(v)/cap*(ih*.46),pts=rs.map((r,i)=>x(i).toFixed(1)+','+y(r.score).toFixed(1)).join(' '),worstIndex=Math.max(0,rs.indexOf(worst)),labels=[];for(let i=0;i<n;i++){if(n<=8||i===0||i===n-1||i===worstIndex||i%Math.ceil(n/6)===0)labels.push('<text class="moveLabel" x="'+x(i).toFixed(1)+'" y="'+(H-7)+'">'+rs[i].no+'</text>')}let dots=rs.map((r,i)=>'<circle class="point '+(i===worstIndex?'worst':'')+'" cx="'+x(i).toFixed(1)+'" cy="'+y(r.score).toFixed(1)+'" r="'+(i===worstIndex?4.4:3.1)+'"><title>'+r.no+'手目 '+r.moveText+' / 形勢 '+Math.round(r.score)+' / 損失 '+Math.round(r.diff)+'</title></circle>').join('');let top=y(cap),mid=y(0),bot=y(-cap);return '<div class="reviewGraph"><div class="reviewGraphHead"><b>形勢の推移</b><span class="reviewGraphLegend">上＝あなた有利　下＝相手有利</span></div><svg viewBox="0 0 '+W+' '+H+'" role="img" aria-label="形勢の推移グラフ"><line class="grid" x1="'+L+'" y1="'+top+'" x2="'+(W-R)+'" y2="'+top+'"/><line class="zero" x1="'+L+'" y1="'+mid+'" x2="'+(W-R)+'" y2="'+mid+'"/><line class="grid" x1="'+L+'" y1="'+bot+'" x2="'+(W-R)+'" y2="'+bot+'"/><text class="axisLabel" x="2" y="'+(top+3)+'">あなた</text><text class="axisLabel" x="5" y="'+(mid+3)+'">互角</text><text class="axisLabel" x="2" y="'+(bot+3)+'">相手</text><polyline class="line" points="'+pts+'"/>'+dots+labels.join('')+'</svg><div class="reviewGraphNote">●はあなたの各指し手後のAI評価。大きい丸は今回の最大分岐点です。評価は見やすさのため±1200で表示を丸めています。</div></div>'}  
function renderReviewResults(){let box=document.getElementById('reviewSummary'),stt=document.getElementById('reviewStatus');if(!box)return;if(!reviewResults.length){box.innerHTML='<div class="reviewEmpty">振り返れる手がありません。</div>';return}let byWorst=reviewResults.slice().sort((a,b)=>b.diff-a.diff),byBest=reviewResults.slice().sort((a,b)=>a.diff-b.diff),worst=byWorst[0],good=byBest.slice(0,3),bad=byWorst.filter(r=>r.diff>=140).slice(0,3);let row=r=>'<div class="reviewRow"><div><span class="reviewGrade '+r.gc+'">'+r.gl+'</span></div><div><div class="reviewMove">'+r.no+'手目 '+r.moveText+'</div><div class="reviewBest">AI候補 '+r.bestText+'</div></div><div class="reviewLoss">損失 '+Math.round(r.diff)+'</div></div>';let point=worst.diff<55?'大きな崩れはありませんでした。最も差が出たのは '+worst.no+'手目 '+worst.moveText+' です。':'最大の分岐点は '+worst.no+'手目 '+worst.moveText+'。AI候補は '+worst.bestText+'、損失目安 '+Math.round(worst.diff)+' でした。',badHtml=bad.length?bad.map(row).join(''):'<div class="reviewPoint">大きな疑問手・悪手は見つかりませんでした。</div>';box.innerHTML=reviewGraphHTML(reviewResults,worst)+'<div class="reviewSection"><b>勝負の分岐点</b><div class="reviewPoint">'+point+'</div></div><div class="reviewSection"><b>良かった手 3つ</b>'+good.map(row).join('')+'</div><div class="reviewSection"><b>改善したい手 3つ</b>'+badHtml+'</div><div class="reviewSection"><b>次に覚えること</b><div class="reviewLesson">'+reviewLessonFrom(worst)+'</div></div>';if(stt)stt.textContent='振り返り完了。'+reviewResults.length+'手をAI先生が確認しました。'}
function runReview(){if(reviewRunning||thinking)return;let b=document.getElementById('reviewBtn'),stt=document.getElementById('reviewStatus'),pf=document.getElementById('reviewProgressFill'),sum=document.getElementById('reviewSummary');if(!reviewTrail.length){if(stt)stt.textContent='まだあなたの指し手がありません。1手以上指してから振り返ってください。';return}reviewRunning=true;reviewResults=[];if(b){b.disabled=true;b.textContent='振り返り中…'}if(sum)sum.innerHTML='';let i=0,mobile=/iPhone|iPad|iPod|Android|Silk/i.test(navigator.userAgent),bestBudget=mobile?85:130,forcedBudget=mobile?45:70;function step(){if(i>=reviewTrail.length){reviewRunning=false;if(b){b.disabled=false;b.textContent=gameCounted?'もう一度振り返る':'ここまで振り返る'}if(pf)pf.style.width='100%';renderReviewResults();return}let x=reviewTrail[i];if(stt)stt.textContent='AI先生が '+(i+1)+' / '+reviewTrail.length+' 手を確認中…';try{let base=chooseAI(clone(x.before),0,bestBudget),d=Math.max(1,Math.min(3,base.info.depth||2)),actual=forcedScore(clone(x.before),x.move,d,forcedBudget),bestScore=base.info.score??actual,diff=Math.max(0,bestScore-actual),g=reviewGrade(diff);reviewResults.push({no:i+1,ply:x.ply,before:x.before,move:x.move,moveText:x.moveText,best:base.move,bestText:jpMove(base.move,x.before),diff,gl:g[0],gc:g[1],score:actual})}catch(e){let g=reviewGrade(0);reviewResults.push({no:i+1,ply:x.ply,before:x.before,move:x.move,moveText:x.moveText,best:null,bestText:'—',diff:0,gl:g[0],gc:g[1],score:0})}i++;if(pf)pf.style.width=Math.round(i/reviewTrail.length*100)+'%';setTimeout(step,24)}setTimeout(step,20)}

function forcedScore(s,m,d=3,budget=140){let original=s.t,sty=STYLE[0];deadline=performance.now()+budget;nodes=0;qnodes=0;try{return Math.round(-nsearch(apply(s,m),Math.max(0,d-1),-1e9,1e9,1,3,sty))}catch(e){return Math.round(evals(apply(s,m),original,sty))}}
function adviceFor(s,m,score){if(incheck(s,S))return'王手を受けるのが最優先です。おすすめ手を中心に、王の安全を確保しましょう。';if(!m)return'終局しています。棋譜を見ながら振り返りましょう。';let cap=s.b[m.to],n=apply(s,m);if(incheck(n,n.t))return'王手をかけながら主導権を取れる手です。相手玉の逃げ道も意識しましょう。';if(cap&&(BASE(cap.k)=='R'||BASE(cap.k)=='B'))return'大駒を取れるチャンスです。駒得を確実にしてから攻めを続けるのが有力です。';if(m.prom)return'成りで駒の働きを大きくできる局面です。敵陣での駒効率を優先しましょう。';let md=materialDiff(s);if(md<-500)return'駒損しています。無理な交換より、王手や当たりを絡めて駒を取り返す手を探しましょう。';if(score>350)return'形勢は良いです。急ぎすぎず、相手の反撃を消しながら優位を広げましょう。';if(score<-350)return'苦しい局面です。受け一辺倒より、相手玉への脅威を作る手も候補に入れましょう。';return'大きな差はありません。駒の働きと玉の安全を両立する手を選びましょう。'}
function setTeacher(score,m,info,lastHtml){let lab=shape(score),pct=Math.max(-48,Math.min(48,score/18)),fill=document.getElementById('evalFill');document.getElementById('shapeLabel').textContent='形勢：'+lab;document.getElementById('evalNumber').textContent=(score>=0?'+':'')+score;fill.style.width=Math.abs(pct)+'%';fill.style.left=pct>=0?'50%':(50-Math.abs(pct))+'%';fill.style.background=pct>=0?'#d5b35d':'#9e785f';document.getElementById('teacherMove').textContent='おすすめ手：'+jpMove(m,st);document.getElementById('teacherText').textContent=adviceFor(st,m,score)+'　解析 深さ'+(info.depth||0)+' / '+((info.nodes||0)+(info.qnodes||0)).toLocaleString()+'局面';document.getElementById('lastMoveText').innerHTML=lastHtml||'直前の一手：評価対象なし'}
function resetTeacher(){document.getElementById('shapeLabel').textContent='形勢：—';document.getElementById('evalNumber').textContent='—';document.getElementById('evalFill').style.width='0';document.getElementById('teacherMove').textContent='おすすめ手：解析すると表示';document.getElementById('teacherText').textContent='対局中は軽く動作し、必要な時だけAI先生が局面を読みます。';document.getElementById('lastMoveText').textContent='直前の一手：まだ評価していません'}
function runAnalysis(){if(analysisRunning||thinking)return;analysisRunning=true;let btn=document.getElementById('analyzeBtn');btn.disabled=true;btn.textContent='解析中…';document.getElementById('teacherText').textContent='AI先生が局面を読んでいます…';setTimeout(()=>{try{let mobile=/iPhone|iPad|iPod|Android|Silk/i.test(navigator.userAgent),res=chooseAI(clone(st),0,mobile?520:820),score=res.info.score??Math.round(evals(st,S,STYLE[0]));if(st.t==G)score=-score;let last='直前の一手：評価対象なし';if(lastHumanBefore&&lastHumanMove){let base=chooseAI(clone(lastHumanBefore),0,mobile?260:420),d=Math.max(1,Math.min(3,base.info.depth||2)),actual=forcedScore(clone(lastHumanBefore),lastHumanMove,d,mobile?100:160),diff=Math.max(0,(base.info.score??actual)-actual),g=grade(diff);last='直前の一手：<span class="moveGrade '+g[1]+'">'+g[0]+'</span>　損失目安 '+Math.round(diff)}setTeacher(score,res.move,res.info,last)}catch(e){document.getElementById('teacherText').textContent='解析できませんでした。対局はそのまま続けられます。'}finally{analysisRunning=false;btn.disabled=false;btn.textContent='この局面を解析'}},30)}
function aiMove(){if(st.t!=G||thinking||gameCounted)return;if(finishIfEnded())return;thinking=true;if(ci<5)showSpeech('think',true);setStatus(C[ci][0]+'が考えています…');setTimeout(()=>{let res=chooseAI(st,ci),best=res.move;lastAIInfo=res.info;if(best)push(best,'△');thinking=false;speechMood='auto';lastSpeech='';render();renderOpponent(true);if(finishIfEnded())return;let x=lastAIInfo;setStatus('あなたの手番です。'+(x.book?' 定跡':x.mate1?' 1手詰め':' 深さ'+x.depth+' / '+(x.nodes+x.qnodes).toLocaleString()+'局面 / '+x.ms+'ms'))},80)}
function push(m,mark){hist.push(clone(st));let before=st,txt=mark+sqname(m.to)+(m.drop?' '+KJ[m.drop]+'打':' '+KJ[(m.prom?PRO(before.b[m.f].k):before.b[m.f].k)]);st=apply(st,m);st.log=before.log.concat(txt);repHistory.push(repEntry(st));sel=null;drop=null;render()}
function setStatus(t){document.getElementById('status').textContent=t;document.getElementById('fstatus').textContent=t}
function renderBoard(id){let el=document.getElementById(id);el.innerHTML='';let lm=st.t==S&&!gameCounted?legal(st):[],targets=[];if(sel!=null)targets=lm.filter(m=>m.f==sel);if(drop)targets=lm.filter(m=>m.drop==drop);for(let i=0;i<81;i++){let q=document.createElement('div');q.className='sq';if(i==sel)q.classList.add('sel');let tm=targets.filter(m=>m.to==i);if(tm.length){q.classList.add('legal');if(st.b[i])q.classList.add('cap')}if(st.last&&(st.last.to==i||st.last.f==i))q.classList.add('last');let p=st.b[i];if(p){let z=document.createElement('div');z.className='piece '+(p.o==G?'g ':'')+(p.k[0]=='+'?'pro':'');z.textContent=KJ[p.k];q.appendChild(z)}q.onclick=()=>tap(i,tm);el.appendChild(q)}}
function tap(i,tm){if(thinking||st.t!=S||gameCounted)return;if(tm.length){let m=tm[0];if(tm.length>1){let pm=tm.find(x=>x.prom);if(pm&&confirm('成りますか？'))m=pm;else m=tm.find(x=>!x.prom)||pm}lastHumanBefore=clone(st);lastHumanMove={...m};reviewTrail.push({ply:st.log.length+1,before:clone(st),move:{...m},moveText:jpMove(m,st)});reviewResults=[];let rs=document.getElementById('reviewStatus');if(rs)rs.textContent='ここまで '+reviewTrail.length+'手、振り返れます。';push(m,'▲');if(finishIfEnded())return;setTimeout(aiMove,100);return}drop=null;let p=st.b[i];sel=p&&p.o==S?i:null;render()}
function renderHand(id,o){let el=document.getElementById(id),lab=o==S?'あなた':'相手';el.innerHTML='<b>'+lab+'</b>';for(const k of['R','B','G','S','N','L','P']){let n=st.h[o][k]||0;if(!n)continue;let b=document.createElement('button');b.className='hp'+(o==S&&drop==k?' sel':'');b.textContent=KJ[k]+'×'+n;if(o==S)b.onclick=()=>{if(gameCounted)return;sel=null;drop=drop==k?null:k;render()};el.appendChild(b)}}
function render(){renderBoard('board');renderBoard('fboard');renderHand('sHand',S);renderHand('gHand',G);renderHand('fsHand',S);renderHand('fgHand',G);document.getElementById('moves').innerHTML=st.log.length?st.log.map((x,i)=>'<div>'+(i+1)+'. '+x+'</div>').join(''):'まだ棋譜はありません';document.getElementById('charInfo').textContent='対戦相手：'+C[ci][0]+'　ゲーム内R'+C[ci][1]+'　'+rankText(ci)+'｜'+CHAR_META[ci].style+'｜'+CHAR_META[ci].feature;document.querySelectorAll('.ch').forEach((e,i)=>e.classList.toggle('on',i==ci));renderOpponent(false);renderStats()}
function newGame(){st=initial();hist=[];repHistory=[repEntry(st)];sel=drop=null;thinking=false;gameCounted=false;lastHumanBefore=null;lastHumanMove=null;lastSpeech='';speechMood='start';clearResult();resetTeacher();resetReview();setStatus('あなたが先手です。');render();renderOpponent(true)}
function undo(){if(gameCounted){setStatus('終局後は「新規対局」で次の対局を始めてください。');return}if(!hist.length)return;st=hist.pop();if(st.t==G&&hist.length)st=hist.pop();repHistory=repHistory.slice(0,st.log.length+1);sel=drop=null;thinking=false;lastHumanBefore=null;lastHumanMove=null;speechMood='undo';lastSpeech='';resetTeacher();syncReviewAfterUndo();setStatus('待ったしました。');render();renderOpponent(true)}
let ce=document.getElementById('chars');C.forEach((c,i)=>{let b=document.createElement('button');b.className='ch';let pic=i<5?'<img class="chPic" alt="'+c[0]+'" src="'+FIXED_IMG[i]+'">':'<span class="chPh">'+c[0].slice(0,1)+'</span>';b.innerHTML=pic+(i<5?'<span class="chFixed">固定</span>':'<span class="chTemp">仮絵</span>')+'<div class="chName">'+c[0]+'</div><div class="chRating">R'+c[1]+'</div><div class="chStyle">'+CHAR_META[i].style+'</div>';b.title=c[0]+'｜R'+c[1]+'｜'+CHAR_META[i].style+'｜'+CHAR_META[i].feature;b.onclick=()=>{ci=i;lastSpeech='';speechMood='start';newGame()};ce.appendChild(b)});
function syncAppHeight(){let h=(window.visualViewport&&window.visualViewport.height)||window.innerH