function rulesAudit(){let empty=()=>({b:Array(81).fill(null),h:{1:{},'-1':{}},t:S,log:[],last:null}),r={};
let k=empty();k.b[idx(8,8)]={k:'K',o:S};k.b[idx(4,0)]={k:'K',o:G};k.b[idx(4,2)]={k:'R',o:S};r.kingCaptureBlocked=!legal(k,S).some(m=>m.to==idx(4,0));
let u=empty();u.b[idx(8,8)]={k:'K',o:S};u.b[idx(4,0)]={k:'K',o:G};u.b[idx(4,2)]={k:'G',o:S};for(const [x,y] of [[3,0],[5,0]])u.b[idx(x,y)]={k:'L',o:G};for(const [x,y] of [[3,1],[5,1]])u.b[idx(x,y)]={k:'P',o:G};u.h[S].P=1;r.pawnDropMateBlocked=!legal(u,S).some(m=>m.drop=='P'&&m.to==idx(4,1));
let n=empty();n.b[idx(8,8)]={k:'K',o:S};n.b[idx(0,0)]={k:'K',o:G};n.b[idx(4,5)]={k:'P',o:S};n.h[S].P=1;r.nifuBlocked=!legal(n,S).some(m=>m.drop=='P'&&xy(m.to)[0]==4);
let d=empty();d.b[idx(8,8)]={k:'K',o:S};d.b[idx(0,0)]={k:'K',o:G};d.h[S].P=1;d.h[S].L=1;d.h[S].N=1;let dl=legal(d,S);r.deadDropsBlocked=!dl.some(m=>(m.drop=='P'||m.drop=='L')&&xy(m.to)[1]==0)&&!dl.some(m=>m.drop=='N'&&xy(m.to)[1]<=1);
let saveSt=st,saveRep=repHistory;st=empty();st.b[idx(8,8)]={k:'K',o:S};st.b[idx(0,0)]={k:'K',o:G};let e=repEntry(st);repHistory=[e,{key:'x1',t:G,inCheck:false},e,{key:'x2',t:G,inCheck:false},e,{key:'x3',t:G,inCheck:false},e];r.repetitionDraw=repetitionResult()?.type=='draw';repHistory=[{...e,inCheck:true},{key:'y1',t:G,inCheck:false},{...e,inCheck:true},{key:'y2',t:G,inCheck:false},{...e,inCheck:true},{key:'y3',t:G,inCheck:false},{...e,inCheck:true}];let pr=repetitionResult();r.perpetualCheckLoss=pr?.type=='perpetual'&&pr.loser==G&&pr.winner==S;st=saveSt;repHistory=saveRep;r.pass=Object.values(r).every(Boolean);return r}
window.AIShogiIOS={legal:()=>legal(st).map(usi),state:()=>st,char:()=>C[ci],select:i=>{ci=Math.max(0,Math.min(C.length-1,+i||0));newGame();return C[ci]},search:(i=ci,b=250)=>{let r=chooseAI(clone(st),i,b);return{move:r.move?usi(r.move):null,info:r.info}},info:()=>lastAIInfo,stats:()=>stats,speech:()=>document.getElementById('charSpeech').textContent,dialogues:(i=ci)=>JSON.parse(JSON.stringify(i<5?DIALOGUES[i]:(TEMP_DIALOGUES[i-5]||{}))),characters:()=>C.map((c,i)=>({name:c[0],rating:c[1],fixed:i<5,style:CHAR_META[i].style,feature:CHAR_META[i].feature})),speechMood:m=>{speechMood=m;lastSpeech='';renderOpponent(true);return document.getElementById('charSpeech').textContent},analyze:runAnalysis,review:runReview,reviewTrail:()=>reviewTrail.map(x=>({ply:x.ply,moveText:x.moveText})),reviewResults:()=>reviewResults.map(x=>({no:x.no,moveText:x.moveText,bestText:x.bestText,diff:x.diff,grade:x.gl})),rulesAudit};
