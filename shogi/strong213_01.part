2,"def":1.18,"pos":1.08,"end":1.22},{"atk":1.15,"def":1.16,"pos":1.18,"end":1.25}],CHAR_META=[{"style":"最強万能型・終盤最強","feature":"みっちゃんが成長した最強形。攻め・受け・読み・寄せのすべてが最高水準。"},{"style":"破天荒・スピード万能型","feature":"自由で予測不能。明るいのに強く、攻めと終盤で一気に持っていく。"},{"style":"万能型・終盤強め","feature":"落ち着いた本格派。無理をせず、終盤で正確に勝ち切る。"},{"style":"堅実・受け強め","feature":"ミスに厳しく、受けてから反撃。じわじわ追い詰める。"},{"style":"バランス・立て直し型","feature":"無理をせず安定して指す。崩れても落ち着いて立て直す。"},{"style":"正統派・精密居飛車","feature":"角換わり・相掛かり。筋の良い手を積み重ねる本格居飛車。"},{"style":"受け将棋・矢倉党","feature":"矢倉中心。守りを固めて相手の攻めを受け切る。"},{"style":"スピード居飛車","feature":"相掛かり中心。テンポよく主導権を握る。"},{"style":"豪腕攻め将棋","feature":"棒銀・右四間。攻めが始まると止まりにくい。"},{"style":"角換わり精密型","feature":"角交換後の細かな駒組みと読み合いを得意とする。"},{"style":"四間飛車党","feature":"四間飛車・美濃囲い。堅く囲って反撃する。"},{"style":"横歩取り・乱戦型","feature":"横歩取りを好み、激しい読み合いと乱戦に強い。"},{"style":"急戦・早繰り銀","feature":"序盤から圧力をかける。攻めの速度を重視。"},{"style":"三間飛車・石田流","feature":"振り飛車からさばきを狙う。軽快な攻めが特徴。"},{"style":"中飛車・美濃型","feature":"中央から戦い、美濃囲いで粘り強く指す。"},{"style":"ゴキゲン中飛車猛攻","feature":"中飛車から激しく攻める。終盤も攻め切る力が高い。"},{"style":"向かい飛車・柔軟型","feature":"相手に合わせて形を変える。柔らかい振り飛車。"},{"style":"雁木・策士型","feature":"雁木を軸に罠と構想で相手を迷わせる。"},{"style":"力戦・実戦型","feature":"定跡に縛られず、実戦的な難しい局面へ持ち込む。"},{"style":"居飛車穴熊・反撃型","feature":"堅い玉を生かし、相手の攻めを受けてから反撃。"},{"style":"持久戦・間合い型","feature":"矢倉・持久戦。急がず間合いを測って勝負する。"},{"style":"軍師・万能型","feature":"局面に合わせて戦型を変える。攻守のバランスが非常に高い。"},{"style":"奇襲・自由型","feature":"常識にとらわれない仕掛け。読みにくい手で揺さぶる。"},{"style":"振り飛車穴熊・終盤型","feature":"堅い振り飛車穴熊から終盤力で逆転を狙う。"},{"style":"師範・最強万能型","feature":"仮キャラ勢の最高峰。定跡・受け・寄せを高水準でこなす。"}],TEMP_DIALOGUES=[{"start":["柳生 晴明です。よろしく。","筋を大切に指しましょう。"],"normal":["筋を大切に指しましょう。","角の働きを丁寧に見ます。","一手ずつ精密にいきます。"],"winning":["少しこちらが指しやすいですね。","この流れを大切にします。"],"losing":["まだ崩れてはいません。","ここから読み直します。"],"critical":["ここが勝負どころです。","最後まで粘ります。"],"think":["少し読みます。","候補手を整理しています。"],"win":["ありがとうございました。","いい将棋でした。"],"loss":["参りました。","次はもっといい将棋にします。"],"undo":["もう一度考えてみましょう。"]},{"start":["藤堂 楓です。よろしく。","まずは受けを整えます。"],"normal":["まずは受けを整えます。","矢倉は簡単には崩れません。","焦らず守りからです。"],"winning":