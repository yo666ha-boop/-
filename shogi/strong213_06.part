FIXED_IMG[1]='data:image/webp;base64,';
FIXED_IMG[2]='./akiou.webp?v=2130';
FIXED_IMG[3]='data:image/webp;base64,';
FIXED_IMG[4]='data:image/webp;base64,';
function upgradeCharCardsV294(){document.querySelectorAll('#chars .ch').forEach((b,i)=>{let img=b.querySelector('img');if(img&&i<5)img.src=FIXED_IMG[i];let s=b.querySelector('.chStyle');if(s)s.textContent=CHAR_META[i].style+'｜'+openingLabel(i);b.title=C[i][0]+'｜R'+C[i][1]+'｜'+openingLabel(i)+'｜'+CHAR_META[i].style+'｜'+CHAR_META[i].feature;});}
const renderBaseV294=render;
render=function(){renderBaseV294();let x=document.getElementById('charInfo');if(x)x.textContent='対戦相手：'+C[ci][0]+'　ゲーム内R'+C[ci][1]+'　'+rankText(ci)+'｜難易度 '+levelText(ci)+'｜得意戦型 '+openingLabel(ci)+'｜'+CHAR_META[ci].style+'｜'+CHAR_META[ci].feature;};
aiMove=function(){if(st.t!=G||thinking||gameCounted)return;if(finishIfEnded())return;thinking=true;if(ci<5)showSpeech('think',true);setStatus(C[ci][0]+'が考えています…');setTimeout(()=>{let res=chooseAI(st,ci),best=res.move;lastAIInfo=res.info;if(best)push(best,'△');thinking=false;speechMood='auto';lastSpeech='';render();renderOpponent(true);if(finishIfEnded())return;let x=lastAIInfo;setStatus('あなたの手番です。'+(x.book?' 定跡（'+(x.bookName||openingLabel(ci))+'）':x.mate1?' 1手詰め':' 探索深さ'+x.depth+'＋戦術延長'+aiSettings(C[ci][1],ci).q+' / '+(x.nodes+x.qnodes).toLocaleString()+'局面 / TT '+(x.ttHits||0)+'hit / '+x.ms+'ms'+((x.choiceRank||1)>1?' / 実戦候補'+x.choiceRank+'位':'')))},80)};
window.AI_SHOGI_BUILD='2.13.0-v294-strong-restored';window.AI_SHOGI_ENGINE={base:'v2.9.4-PVS-TT-qsearch',repeatGuard:true,speechNoImmediateRepeat:true};
window.AIShogiIOS={...window.AIShogiIOS,characters:()=>C.map((c,i)=>({name:c[0],rating:c[1],fixed:i<5,level:levelText(i),style:CHAR_META[i].style,feature:CHAR_META[i].feature,opening:openingLabel(i)})),settings:(i=ci)=>({name:C[i][0],rating:C[i][1],level:levelText(i),ai:aiSettings(C[i][1],i),style:{...STYLE[i]},opening:openingLabel(i)})};
upgradeCharCardsV294();render();renderOpponent(true);

})();
