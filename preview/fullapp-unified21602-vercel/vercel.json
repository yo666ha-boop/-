{
  "redirects": [
    { "source": "/", "destination": "/shogi-v21528/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/shogi-v21528/:path*", "destination": "/api/proxy?path=shogi-v21528/:path*" },
    { "source": "/shogi/:path*", "destination": "/api/proxy?path=shogi/:path*" },
    { "source": "/shogi-side-test/:path*", "destination": "/api/proxy?path=shogi-side-test/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
